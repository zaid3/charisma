{
    admin off
    auto_https off
}
:8080 {
    forward_auth monitor:8787 {
        uri /edge/check
        header_up Authorization "Bearer {$CHARISMA_GATEWAY_TOKEN}"
        header_up X-Charisma-Service website
        header_up X-Charisma-Source-IP {remote_host}
    }
    respond "Protected fixture website" 200
}
:8081 {
    forward_auth monitor:8787 {
        uri /edge/check
        header_up Authorization "Bearer {$CHARISMA_GATEWAY_TOKEN}"
        header_up X-Charisma-Service accounts
        header_up X-Charisma-Source-IP {remote_host}
    }
    respond "Unaffected fixture accounts" 200
}
